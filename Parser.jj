/* Compilador de Mini-REXX
 * Practica 02 - Procesadores del Lenguaje
 */

options {
  STATIC = false; // Para que no sea estatico y se pueda usar en otros programas.
  IGNORE_CASE = true; // No distingue minusculas de mayusculas.
}

PARSER_BEGIN(REXXCompiler)

import java.io.FileInputStream;
import java.io.InputStream;

public class REXXCompiler {

    // Contador para generar etiquetas unicas (LBL0, LBL1, ...)
    int contadorEtiquetas = 0;

    int nuevaEtiqueta() {
        return contadorEtiquetas++;
    }

    public static void main(String[] args) throws Exception {
        InputStream input;
        if (args.length > 0) {
            input = new FileInputStream(args[0]);
        } else {
            input = System.in;
        }
        REXXCompiler compiler = new REXXCompiler(input);
        compiler.programa();
    }
}

PARSER_END(REXXCompiler)

/* --- Reglas lexicas --- */

// Caracteres y separadores ignorados
SKIP : {
    " "
  | "\t"
  | "\r"
  | "\n"
  | ";" // Hemos encontrado que el enunciado dice que ignoremos los ; también
}

// Comentarios multilinea
SKIP : {
    "/*" : DENTRO_COMENTARIO
}

<DENTRO_COMENTARIO> SKIP : { //Estamos dentro de un comentario
    "*/" : DEFAULT // si encuentra un fin de comentario vuelve al estado DEFAULT
  | < ~[] > // cualquier otro caracter se ignora
}

// Palabras reservadas
TOKEN : {
    < PULL: "PULL" >
  | < SAY: "SAY" >
  | < IF: "IF" >
  | < THEN: "THEN" >
  | < ELSE: "ELSE" >
  | < DO: "DO" >
  | < END: "END" >
  | < WHILE: "WHILE" >
  | < UNTIL: "UNTIL" >
  | < TO: "TO" >
  | < BY: "BY" >
  | < SELECT: "SELECT" >
  | < WHEN: "WHEN" >
  | < OTHERWISE: "OTHERWISE" >
  | < CHOOSE: "CHOOSE" >
  | < ADDING: "ADDING" >
  | < SUBTRACTING: "SUBTRACTING" >
}

// Otros elementos
TOKEN : {
    < NUM: (["0"-"9"])+ >
  | < ID: (["a"-"z", "A"-"Z", "_"]) (["a"-"z", "A"-"Z", "0"-"9", "_"])* >
  | < CAD:
        "\"" (~["\"", "\r", "\n"])* "\""
      | "'" (~["'", "\r", "\n"])* "'"
    >
}

/* --- Producciones gramaticales --- */

void programa() : {} {
  sentencias() <EOF>
}

void sentencias() : {} {
  ( sentencia() )*
}

void sentencia() : {} {
    entrada()
  | asignacion()
  | salida()
}

void asignacion() :
{
  Token id;
}
{
  id=<ID> "=" { System.out.println("valori " + id.image.toLowerCase()); }
  expresion()
  { System.out.println("asigna"); }
}

void salida() :
{
  int numElementos = 0;
}
{
  <SAY>
  elem_salida() { numElementos++; }
  (
    ","
    elem_salida() { numElementos++; }
  )*
  {
    System.out.println("print " + numElementos);
  }
}

void elem_salida() :
{
  Token cad;
}
{
    cad=<CAD> { System.out.println("metecad " + cad.image); }
  | expresion()
}

void entrada() :
{
  Token id;
}
{
  <PULL> id=<ID> // asignamos el <id> detectado a la variable id
  {
    System.out.println("lee " + id.image.toLowerCase()); //imprimimos en minusculas
  }
}

/* --- Expresiones aritmeticas --- */

// Evalua sumas y restas (menor importancia)
void expresion() : {} {
  termino()
  (
      "+" termino() { System.out.println("add"); }
    | "-" termino() { System.out.println("sub"); }
  )*
}

// Evalua multiplicaciones y divisiones (importancia media)
void termino() : {} {
  factor()
  (
      "*" factor() { System.out.println("mul"); }
    | "/" factor() { System.out.println("div"); }
  )*
}

// Gestionamos los signos, restando a 0 el número para que sea negativo
void factor() :
{
  boolean esNegativo = false;
}
{
  (
      "+"
    | "-" { esNegativo = true; System.out.println("mete 0"); }
  )?
  atomo()
  {
    if (esNegativo) {
      System.out.println("sub");
    }
  }
}

// Elementos basicos: numeros, variables, expresiones entre parentesis o el operador CHOOSE
void atomo() :
{
  Token t;
}
{
    t=<NUM> { System.out.println("mete " + t.image); }
  | t=<ID>  { System.out.println("valord " + t.image.toLowerCase()); }
  | "(" expresion() ")"
  | elegir()
}

// Expresion condicional: CHOOSE(condicion, exprVerdadera, exprFalsa)
void elegir() :
{
  int lblFalso = nuevaEtiqueta();
  int lblFin = nuevaEtiqueta();
}
{
  <CHOOSE> "("
  condicion()
  {
    System.out.println("sifalsovea LBL" + lblFalso);
  }
  ","
  expresion()
  {
    System.out.println("vea LBL" + lblFin);
    System.out.println("LBL" + lblFalso + ":");
  }
  ","
  expresion()
  ")"
  {
    System.out.println("LBL" + lblFin + ":");
  }
}

/* --- Condiciones logicas --- */

// Evaluamos los operadores relacionales
void condicion() : {}
{
  expresion()
  (
      "="  expresion() { System.out.println("esigual"); }
    | "<>" expresion() { System.out.println("esigual"); System.out.println("not"); }
    | "<=" expresion() { System.out.println("esmayor"); System.out.println("not"); }
    | ">=" expresion() { System.out.println("esmenor"); System.out.println("not"); }
    | "<"  expresion() { System.out.println("esmenor"); }
    | ">"  expresion() { System.out.println("esmayor"); }
  )
}
