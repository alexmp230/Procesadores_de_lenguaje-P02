/* Compilador de Mini-REXX
 * Practica 02 - Procesadores del Lenguaje
 */

options {
  STATIC = false; // Para que no sea estatico y se pueda usar en otros programas.
  IGNORE_CASE = true; // No distingue minusculas de mayusculas.
}

PARSER_BEGIN(REXXCompiler)

import java.io.FileInputStream;
import java.io.InputStream;

public class REXXCompiler {

    public static void main(String[] args) throws Exception {
        InputStream input;
        if (args.length > 0) {
            input = new FileInputStream(args[0]);
        } else {
            input = System.in;
        }
        REXXCompiler compiler = new REXXCompiler(input);
        compiler.programa();
    }
}

PARSER_END(REXXCompiler)

/* --- Reglas lexicas --- */

// Caracteres y separadores ignorados
SKIP : {
    " "
  | "\t"
  | "\r"
  | "\n"
  | ";" // Hemos encontrado que el enunciado dice que ignoremos los ; también
}

// Comentarios multilinea
SKIP : {
    "/*" : DENTRO_COMENTARIO
}

<DENTRO_COMENTARIO> SKIP : { //Estamos dentro de un comentario
    "*/" : DEFAULT // si encuentra un fin de comentario vuelve al estado DEFAULT
  | < ~[] > // cualquier otro caracter se ignora
}

// Palabras reservadas
TOKEN : {
    < PULL: "PULL" >
  | < SAY: "SAY" >
  | < IF: "IF" >
  | < THEN: "THEN" >
  | < ELSE: "ELSE" >
  | < DO: "DO" >
  | < END: "END" >
  | < WHILE: "WHILE" >
  | < UNTIL: "UNTIL" >
  | < TO: "TO" >
  | < BY: "BY" >
  | < SELECT: "SELECT" >
  | < WHEN: "WHEN" >
  | < OTHERWISE: "OTHERWISE" >
  | < CHOOSE: "CHOOSE" >
  | < ADDING: "ADDING" >
  | < SUBTRACTING: "SUBTRACTING" >
}

// Otros elementos
TOKEN : {
    < NUM: (["0"-"9"])+ >
  | < ID: (["a"-"z", "A"-"Z", "_"]) (["a"-"z", "A"-"Z", "0"-"9", "_"])* >
  | < CAD:
        "\"" (~["\"", "\r", "\n"])* "\""
      | "'" (~["'", "\r", "\n"])* "'"
    >
}

/* --- Inicio del analizador --- */
void programa() : {} {
  <EOF>
}
